{
  "manifest_version": 2,
  "name": "Poker Tracker — Hand Export",
  "version": "0.1.3",
  "description": "Export complete Bet88 hand histories from the page you already have open. All data stays local.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hand-export@poker-tracker.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "activeTab", "storage", "unlimitedStorage", "downloads",
    "https://bet88.ph/*", "https://*.bet88.ph/*"
  ],
  "background": {
    "persistent": true,
    "scripts": [
      "lib/core.js", "lib/collector.js", "lib/exporter.js",
      "lib/downloads.js", "lib/controller.js", "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Export poker hands",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
